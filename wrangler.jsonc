{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sehha-apparelos-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "STATIC",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    { "binding": "DB", "migrations_dir": "./migrations" }
  ],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "UPLOADS" }
  ],
  "vars": {
    "APP_ENV": "development",
    "SEHHA_PRODUCT_ID": "SEHHA_APPAREL",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "AI_PROVIDER_ORDER": "anthropic,openai"
  },
  // AI-TP-W01: Workers AI vision is OPT-IN. A top-level "ai" binding makes plain `wrangler dev` open a remote proxy
  // session (Cloudflare login + network) and breaks offline local development/tests, so it lives in env "vision".
  // Use only on a PRIVATE, non-production preview after the owner accepted the Meta Llama 3.2 licence:
  //   npx wrangler dev --env vision        (never `deploy` without separate owner authorization)
  "env": {
    "vision": {
      "name": "sehha-apparelos-vision-preview",
      "workers_dev": false,
      "assets": { "directory": "./public", "binding": "STATIC", "run_worker_first": ["/api/*", "/uploads/*"] },
      "d1_databases": [ { "binding": "DB", "migrations_dir": "./migrations" } ],
      "browser": { "binding": "BROWSER" },
      "ai": { "binding": "AI" },
      "r2_buckets": [ { "binding": "UPLOADS" } ],
      "vars": {
        "APP_ENV": "vision-preview",
        "SEHHA_PRODUCT_ID": "SEHHA_APPAREL",
        "OPENAI_MODEL": "gpt-5.6-luna",
        "ANTHROPIC_MODEL": "claude-sonnet-5",
        "AI_PROVIDER_ORDER": "workers_ai",
        "VISION_DAILY_LIMIT": "3",
        "VISION_MAX_IMAGES_PER_RUN": "2"
      }
    }
  }
}
